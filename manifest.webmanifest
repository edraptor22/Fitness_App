{
  "name": "Lift Log",
  "short_name": "Lift Log",
  "description": "Offline workout tracker with plans, per-set logging and progressive overload history.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
